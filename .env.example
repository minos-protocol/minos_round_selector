# Every value here is already the default. The service and CLI run with no
# configuration at all — this file exists to show what can be changed, not
# because anything needs to be.

# The Minos API to read the published task window from.
MINOS_API=https://api.theminos.ai

# The Bittensor node to read block hashes from. Worth pointing at your own
# node: the block hash is the one input that decides the outcome, so reading it
# directly removes any intermediary from the result.
BITTENSOR_RPC=wss://entrypoint-finney.opentensor.ai:443
